{
  "name": "inrepo",
  "version": "0.0.9",
  "description": "Vendor upstream git repositories into inrepo_modules from declarative config",
  "keywords": [
    "cli",
    "git",
    "vendor"
  ],
  "homepage": "https://github.com/inthhq/inrepo#readme",
  "bugs": {
    "url": "https://github.com/inthhq/inrepo/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inthhq/inrepo.git"
  },
  "bin": {
    "inrepo": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "inrepo.schema.json",
    "AGENTS.md",
    "SKILL.md",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "changeset": "changeset",
    "check": "ultracite check",
    "ci:publish": "bunx changeset tag && bun publish",
    "ci:version": "changeset version",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "docs:bundle": "node ./node_modules/leadtype/dist/cli.js generate --bundle --src . --docs-dir docs-src --out . --name inrepo",
    "docs:check": "node ./node_modules/leadtype/dist/cli.js lint docs-src --max-warnings 0",
    "fix": "ultracite fix",
    "prepack": "bun run build && bun run docs:bundle",
    "release": "bun run build && changeset publish",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:c15t-cli-case": "bun examples/c15t-cli/probe.ts",
    "test:c15t-cli-with-deps": "bun examples/c15t-cli/with-deps-probe.ts",
    "test:c15t-cli-full": "cd examples/c15t-cli && npm run full:prepare && npm run full:check",
    "test:scriptc-example": "bun examples/scriptc/verify.ts",
    "test:watch": "bun test --watch ./src",
    "version": "changeset version && bun install",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "hexbus": "0.6.0",
    "safe-regex": "2.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@types/bun": "1.3.13",
    "@types/node": "22.19.17",
    "@types/safe-regex": "1.1.6",
    "jiti": "2.7.0",
    "leadtype": "0.2.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "rolldown": "1.0.0-rc.17",
    "typescript": "6.0.3",
    "ultracite": "7.10.5"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=20"
  },
  "packageManager": "bun@1.3.12"
}
