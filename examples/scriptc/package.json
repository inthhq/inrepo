{
  "name": "inrepo-example-scriptc",
  "version": "0.0.0",
  "private": true,
  "description": "Benchmark: scriptc with npm deps vs deps vendored into the repo with inrepo",
  "type": "module",
  "scripts": {
    "build": "npm run build:npm && npm run build:vendored",
    "build:npm": "scriptc build cli.ts --dynamic -o demo-npm",
    "build:vendored": "scriptc build cli-vendored.ts -o demo-vendored",
    "check": "bun check.ts",
    "bench": "bun check.ts && bun bench.ts"
  },
  "dependencies": {
    "commander": "15.0.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "mitata": "^1.0.34",
    "scriptc": "^0.0.25"
  }
}
